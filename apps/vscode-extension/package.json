{
  "name": "codeatlas-vscode",
  "displayName": "CodeAtlas - AI Context Intelligence",
  "description": "Give AI a map of your codebase. Native VS Code integration for context intelligence, AST indexing, graph navigation, and rule management.",
  "version": "0.1.0",
  "publisher": "shditz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shditz/codeatlas"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeatlas-sidebar",
          "title": "CodeAtlas",
          "icon": "$(map)"
        }
      ]
    },
    "views": {
      "codeatlas-sidebar": [
        {
          "id": "codeatlas.overview",
          "name": "Codebase Architecture & Map"
        },
        {
          "id": "codeatlas.rules",
          "name": "AI Agent Rules"
        }
      ]
    },
    "commands": [
      {
        "command": "codeatlas.indexCodebase",
        "title": "Index / Refresh Codebase",
        "category": "CodeAtlas"
      },
      {
        "command": "codeatlas.exportContext",
        "title": "Export Context for AI Agent",
        "category": "CodeAtlas"
      },
      {
        "command": "codeatlas.generatePRContext",
        "title": "Generate Git PR Context",
        "category": "CodeAtlas"
      },
      {
        "command": "codeatlas.queryGraph",
        "title": "Run Cypher Graph Query",
        "category": "CodeAtlas"
      },
      {
        "command": "codeatlas.toggleWatcher",
        "title": "Toggle Real-time Watcher",
        "category": "CodeAtlas"
      },
      {
        "command": "codeatlas.openGraphView",
        "title": "Open Interactive Graph View",
        "category": "CodeAtlas",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codeatlas.exportContext",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "codeatlas.exportContext",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "codeatlas.openGraphView",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "codeatlas.openGraphView",
          "when": "view == codeatlas.overview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codeatlas/core": "workspace:*",
    "@codeatlas/shared": "workspace:*",
    "@codeatlas/storage": "workspace:*",
    "@codeatlas/indexer": "workspace:*",
    "@codeatlas/git": "workspace:*",
    "@codeatlas/rules": "workspace:*",
    "@codeatlas/context": "workspace:*",
    "@codeatlas/exporters": "workspace:*",
    "@codeatlas/graph": "workspace:*",
    "@codeatlas/compression": "workspace:*",
    "@codeatlas/retrieval": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
