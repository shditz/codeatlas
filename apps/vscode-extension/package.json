{
  "name": "codeatlas-vscode",
  "displayName": "CodeAtlas - AI Context Intelligence",
  "description": "Give AI a map of your codebase. Native VS Code integration for context intelligence, AST indexing, graph navigation, and rule management.",
  "version": "1.5.1",
  "private": true,
  "publisher": "shditz",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#090d16",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "context",
    "mcp",
    "ast",
    "graph",
    "architecture",
    "codebase",
    "cursor",
    "antigravity",
    "claude"
  ],
  "homepage": "https://github.com/shditz/codeatlas",
  "bugs": {
    "url": "https://github.com/shditz/codeatlas/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shditz/codeatlas"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeatlas-sidebar",
          "title": "CodeAtlas",
          "icon": "$(map)"
        }
      ]
    },
    "views": {
      "codeatlas-sidebar": [
        {
          "id": "codeatlas.overview",
          "name": "Architecture & Codebase Map"
        },
        {
          "id": "codeatlas.analytics",
          "name": "Architecture Health & Diagnostics"
        },
        {
          "id": "codeatlas.rules",
          "name": "AI Agent Rules & Governance"
        },
        {
          "id": "codeatlas.tools",
          "name": "Quick Actions & AI Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "codeatlas.indexCodebase",
        "title": "Index / Refresh Workspace",
        "category": "CodeAtlas",
        "icon": "$(refresh)"
      },
      {
        "command": "codeatlas.exportContext",
        "title": "Export Context Pack",
        "category": "CodeAtlas",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeatlas.generatePRContext",
        "title": "Analyze PR Impact",
        "category": "CodeAtlas",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "codeatlas.queryGraph",
        "title": "Graph Query",
        "category": "CodeAtlas",
        "icon": "$(search)"
      },
      {
        "command": "codeatlas.toggleWatcher",
        "title": "Toggle Real-time Watcher",
        "category": "CodeAtlas",
        "icon": "$(eye)"
      },
      {
        "command": "codeatlas.openGraphView",
        "title": "Open Architecture Map",
        "category": "CodeAtlas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codeatlas.generateRules",
        "title": "Generate AI Rules",
        "category": "CodeAtlas",
        "icon": "$(shield)"
      },
      {
        "command": "codeatlas.clean",
        "title": "Clean Cache & Database",
        "category": "CodeAtlas",
        "icon": "$(trash)"
      },
      {
        "command": "codeatlas.startMCP",
        "title": "Start MCP Server",
        "category": "CodeAtlas",
        "icon": "$(server)"
      },
      {
        "command": "codeatlas.semanticSearch",
        "title": "Semantic Search",
        "category": "CodeAtlas",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "codeatlas.runAudit",
        "title": "Architecture Audit",
        "category": "CodeAtlas",
        "icon": "$(report)"
      },
      {
        "command": "codeatlas.init",
        "title": "Initialize Workspace",
        "category": "CodeAtlas",
        "icon": "$(new-folder)"
      },
      {
        "command": "codeatlas.scan",
        "title": "Quick Scan Workspace",
        "category": "CodeAtlas",
        "icon": "$(search-stop)"
      },
      {
        "command": "codeatlas.doctor",
        "title": "Health Diagnostics",
        "category": "CodeAtlas",
        "icon": "$(pulse)"
      },
      {
        "command": "codeatlas.rulesValidate",
        "title": "Validate AI Rules",
        "category": "CodeAtlas",
        "icon": "$(check-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codeatlas.exportContext",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "codeatlas.exportContext",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "codeatlas.openGraphView",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "codeatlas.indexCodebase",
          "when": "view == codeatlas.overview",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.openGraphView",
          "when": "view == codeatlas.overview",
          "group": "navigation@2"
        },
        {
          "command": "codeatlas.exportContext",
          "when": "view == codeatlas.overview",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codeatlas-ai/analytics": "workspace:*",
    "@codeatlas-ai/core": "workspace:*",
    "@codeatlas-ai/shared": "workspace:*",
    "@codeatlas-ai/storage": "workspace:*",
    "@codeatlas-ai/indexer": "workspace:*",
    "@codeatlas-ai/git": "workspace:*",
    "@codeatlas-ai/rules": "workspace:*",
    "@codeatlas-ai/context": "workspace:*",
    "@codeatlas-ai/exporters": "workspace:*",
    "@codeatlas-ai/graph": "workspace:*",
    "@codeatlas-ai/compression": "workspace:*",
    "@codeatlas-ai/retrieval": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
